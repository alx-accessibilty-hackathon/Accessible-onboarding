# Copy to .env (never commit .env). Read once by Config/config.go.
PORT=8080
APP_ENV=dev
DATABASE_URL=postgres://bridge:bridge@localhost:5432/bridge?sslmode=disable
FLOWS_DIR=../shared/flows
NEEDS_FILE=../shared/vocab/needs.json
PUBLIC_WEB_URL=http://localhost:5173

# 32 random bytes each, base64: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
CODE_HASH_KEY=

# Speech-to-text providers, tried in this order (addis | azure | local | mock).
# addis = Addis AI Scribe (Amharic and English), needs ADDIS_AI_API_KEY below; the widget then
# sends Amharic voice answers to the server. mock = sample text, for testing only (never in
# production: it fills in answers nobody said). Example for production: STT_PROVIDERS=addis
STT_PROVIDERS=mock
STT_TIMEOUT_MS=20000
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
LOCAL_STT_URL=http://localhost:8090

# Read aloud with a server voice (fixed interface text only), for devices without an Amharic voice.
# Addis AI key (https://addisassistant.com/apikeys, starts with sk_): turns on the Amharic voice.
ADDIS_AI_API_KEY=
# The one Amharic voice used for every clip (the API log lists the available voices at start-up).
ADDIS_AI_VOICE_ID=am-hamen
# Speaking speed 1-100; 0 = Addis AI's default.
ADDIS_AI_SPEED=0
# Each clip is made once, then cached: in memory, in this folder ("" = no disk cache) and in the
# database (table tts_cache, kept across restarts). Max paid calls per day (0 = no limit).
TTS_CACHE_DIR=./data/tts_cache
TTS_DAILY_LIMIT=300

# SMS: console (only logged, listed by /api/v1/dev/messages) | smsethiopia (really sent).
# SMS Ethiopia: sign up at smsethiopia.com, then Dashboard > Console > API Keys. The free test
# campaign (100 SMS) only sends to numbers verified in its dashboard. Only Ethio Telecom numbers
# (+2519...). Max SMS per day (0 = no limit); at most 5 an hour to one number.
SMS_PROVIDER=console
SMSETHIOPIA_API_KEY=
SMS_DAILY_LIMIT=50

# Self-service partners: POST /api/v1/partners (the partner guide's form) makes a working key
# and an OAuth client at once. off turns it off; the cap counts new partners per day.
PARTNER_SELF_SERVICE=on
PARTNER_SIGNUP_DAILY_LIMIT=500

# Dev only: extra allowed origins for the co-designer's tunnel
DEV_ALLOWED_ORIGIN_SUFFIX=.trycloudflare.com
# Dev only: more browser origins, comma-separated (e.g. a phone on your Wi-Fi: http://192.168.1.20:5173)
EXTRA_ALLOWED_ORIGINS=

# Telegram bot webhook secret (the webhook only works in dev without it)
TELEGRAM_WEBHOOK_SECRET=

# Demo data (`go run . seed`): staff password and the savanna-demo OAuth client secret.
# Left empty, the seed makes random ones and prints them once.
SEED_STAFF_PASSWORD=
SEED_CLIENT_SECRET=
