{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/v1/audio/:path*",
      "destination": "/audio/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://accessible-onboarding.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://accessible-onboarding.onrender.com/health"
    },
    {
      "source": "/ns/:path*",
      "destination": "https://accessible-onboarding.onrender.com/ns/:path*"
    },
    {
      "source": "/r/:path*",
      "destination": "/index.html"
    }
  ]
}
