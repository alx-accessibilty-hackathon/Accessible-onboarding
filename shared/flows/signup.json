{
  "id": "signup",
  "version": 1,
  "start": "welcome",
  "steps": [
    {
      "id": "welcome",
      "type": "info",
      "title": "signup.welcome.title",
      "hint": "signup.welcome.hint",
      "icon": "waving_hand",
      "next": "consent_data"
    },
    {
      "id": "consent_data",
      "type": "consent",
      "title": "signup.consent_data.title",
      "hint": "signup.consent_data.hint",
      "required": true,
      "storage": "none",
      "next": "full_name"
    },
    {
      "id": "full_name",
      "type": "text",
      "title": "signup.full_name.title",
      "hint": "signup.full_name.hint",
      "icon": "person",
      "autocomplete": "name",
      "required": true,
      "storage": "answer",
      "validate": [{ "rule": "min_length", "value": 2, "error": "too_short" }],
      "next": "contact_method"
    },
    {
      "id": "contact_method",
      "type": "single_choice",
      "title": "signup.contact_method.title",
      "icon": "call",
      "required": true,
      "storage": "answer",
      "options": [
        { "value": "phone", "label": "signup.contact_method.phone", "icon": "smartphone", "say": ["phone", "ስልክ"] },
        { "value": "telegram", "label": "signup.contact_method.telegram", "icon": "send", "say": ["telegram", "ቴሌግራም"] },
        { "value": "partner", "label": "signup.contact_method.partner", "icon": "handshake" },
        { "value": "none", "label": "signup.contact_method.none", "icon": "block" }
      ],
      "next": [
        { "when": { "step": "contact_method", "in": ["phone", "telegram"] }, "goto": "phone" },
        { "goto": "dob" }
      ]
    },
    {
      "id": "phone",
      "type": "phone",
      "title": "signup.phone.title",
      "hint": "signup.phone.hint",
      "icon": "smartphone",
      "autocomplete": "tel",
      "required": true,
      "storage": "answer",
      "validate": [{ "rule": "phone_et", "error": "phone_invalid" }],
      "next": "dob"
    },
    {
      "id": "dob",
      "type": "date",
      "title": "signup.dob.title",
      "hint": "signup.dob.hint",
      "icon": "cake",
      "required": false,
      "storage": "answer",
      "calendar_default": { "am": "ethiopian", "en": "gregorian" },
      "validate": [{ "rule": "date_valid", "error": "date_invalid" }],
      "next": "sex"
    },
    {
      "id": "sex",
      "type": "single_choice",
      "title": "signup.sex.title",
      "hint": "signup.sex.hint",
      "icon": "person",
      "required": false,
      "storage": "answer",
      "options": [
        { "value": "female", "label": "signup.sex.female", "say": ["female", "woman", "ሴት"] },
        { "value": "male", "label": "signup.sex.male", "say": ["male", "man", "ወንድ"] }
      ],
      "next": "region"
    },
    {
      "id": "region",
      "type": "single_choice",
      "title": "signup.region.title",
      "hint": "signup.region.hint",
      "icon": "location_on",
      "required": false,
      "storage": "answer",
      "options": [
        { "value": "addis_ababa", "label": "signup.region.addis_ababa", "say": ["addis ababa", "addis", "አዲስ አበባ"] },
        { "value": "afar", "label": "signup.region.afar", "say": ["afar", "አፋር"] },
        { "value": "amhara", "label": "signup.region.amhara", "say": ["amhara", "አማራ"] },
        { "value": "benishangul_gumuz", "label": "signup.region.benishangul_gumuz", "say": ["benishangul", "ቤኒሻንጉል"] },
        { "value": "central_ethiopia", "label": "signup.region.central_ethiopia", "say": ["central ethiopia", "ማዕከላዊ ኢትዮጵያ"] },
        { "value": "dire_dawa", "label": "signup.region.dire_dawa", "say": ["dire dawa", "ድሬዳዋ", "ድሬ ዳዋ"] },
        { "value": "gambela", "label": "signup.region.gambela", "say": ["gambela", "ጋምቤላ"] },
        { "value": "harari", "label": "signup.region.harari", "say": ["harari", "harar", "ሐረሪ", "ሐረር"] },
        { "value": "oromia", "label": "signup.region.oromia", "say": ["oromia", "ኦሮሚያ"] },
        { "value": "sidama", "label": "signup.region.sidama", "say": ["sidama", "ሲዳማ"] },
        { "value": "somali", "label": "signup.region.somali", "say": ["somali", "ሶማሌ"] },
        { "value": "south_ethiopia", "label": "signup.region.south_ethiopia", "say": ["south ethiopia", "ደቡብ ኢትዮጵያ"] },
        { "value": "south_west_ethiopia", "label": "signup.region.south_west_ethiopia", "say": ["south west", "ደቡብ ምዕራብ"] },
        { "value": "tigray", "label": "signup.region.tigray", "say": ["tigray", "ትግራይ"] },
        { "value": "outside_ethiopia", "label": "signup.region.outside_ethiopia" }
      ],
      "next": "education"
    },
    {
      "id": "education",
      "type": "single_choice",
      "title": "signup.education.title",
      "hint": "signup.education.hint",
      "icon": "school",
      "required": false,
      "storage": "answer",
      "options": [
        { "value": "none", "label": "signup.education.none" },
        { "value": "primary", "label": "signup.education.primary" },
        { "value": "secondary", "label": "signup.education.secondary" },
        { "value": "tvet", "label": "signup.education.tvet", "say": ["tvet", "diploma", "certificate", "ቴክኒክ"] },
        { "value": "degree", "label": "signup.education.degree", "say": ["degree", "university", "ዲግሪ"] },
        { "value": "postgraduate", "label": "signup.education.postgraduate", "say": ["masters", "phd", "ማስተርስ"] }
      ],
      "next": "id_route"
    },
    {
      "id": "id_route",
      "type": "single_choice",
      "title": "signup.id_route.title",
      "hint": "signup.id_route.hint",
      "icon": "badge",
      "required": true,
      "storage": "answer",
      "options": [
        { "value": "fayda", "label": "signup.id_route.fayda", "icon": "badge", "say": ["fayda", "ፋይዳ"] },
        { "value": "kebele_id", "label": "signup.id_route.kebele_id", "icon": "badge", "say": ["kebele", "ቀበሌ"] },
        { "value": "refugee_id", "label": "signup.id_route.refugee_id", "icon": "badge", "say": ["refugee", "ስደተኛ"] },
        { "value": "unhcr_proof", "label": "signup.id_route.unhcr_proof", "icon": "description", "say": ["unhcr"] },
        { "value": "other_document", "label": "signup.id_route.other_document", "icon": "description" },
        { "value": "none", "label": "signup.id_route.none", "icon": "handshake" }
      ],
      "next": [
        { "when": { "step": "id_route", "equals": "none" }, "goto": "referral_partner" },
        { "when": { "step": "id_route", "equals": "other_document" }, "goto": "id_doc_type" },
        { "goto": "id_last4" }
      ]
    },
    {
      "id": "id_doc_type",
      "type": "single_choice",
      "title": "signup.id_doc_type.title",
      "hint": "signup.id_doc_type.hint",
      "icon": "description",
      "required": true,
      "storage": "answer",
      "options": [
        { "value": "student_id", "label": "signup.id_doc_type.student_id" },
        { "value": "birth_certificate", "label": "signup.id_doc_type.birth_certificate" },
        { "value": "idir_equb_id", "label": "signup.id_doc_type.idir_equb_id" },
        { "value": "kebele_letter", "label": "signup.id_doc_type.kebele_letter" },
        { "value": "driving_licence", "label": "signup.id_doc_type.driving_licence" },
        { "value": "passport", "label": "signup.id_doc_type.passport" },
        { "value": "other", "label": "signup.id_doc_type.other" }
      ],
      "next": "id_upload"
    },
    {
      "id": "id_upload",
      "type": "file",
      "title": "signup.id_upload.title",
      "hint": "signup.id_upload.hint",
      "icon": "photo_camera",
      "required": false,
      "storage": "answer",
      "next": [
        { "when": { "step": "id_doc_type", "in": ["kebele_letter", "other"] }, "goto": "support_needs" },
        { "goto": "id_last4" }
      ]
    },
    {
      "id": "id_last4",
      "type": "text",
      "title": "signup.id_last4.title",
      "hint": "signup.id_last4.hint",
      "icon": "pin",
      "autocomplete": "off",
      "required": false,
      "storage": "answer",
      "validate": [{ "rule": "pattern", "value": "^[0-9A-Za-z]{4}$", "error": "last4_invalid" }],
      "next": "support_needs"
    },
    {
      "id": "referral_partner",
      "type": "single_choice",
      "title": "signup.referral_partner.title",
      "hint": "signup.referral_partner.hint",
      "icon": "handshake",
      "required": true,
      "storage": "answer",
      "options_from": "config:referral_partners",
      "next": "referral_contact"
    },
    {
      "id": "referral_contact",
      "type": "single_choice",
      "title": "signup.referral_contact.title",
      "icon": "call",
      "required": true,
      "storage": "answer",
      "options": [
        { "value": "phone", "label": "signup.referral_contact.phone", "icon": "call" },
        { "value": "telegram", "label": "signup.referral_contact.telegram", "icon": "send" },
        { "value": "in_person", "label": "signup.referral_contact.in_person", "icon": "location_on" }
      ],
      "next": "support_needs"
    },
    {
      "id": "support_needs",
      "type": "multi_choice",
      "title": "signup.support_needs.title",
      "hint": "signup.support_needs.hint",
      "icon": "volunteer_activism",
      "required": false,
      "storage": "support",
      "options_from": "vocab:needs",
      "next": "support_other"
    },
    {
      "id": "support_other",
      "type": "long_text",
      "title": "signup.support_other.title",
      "hint": "signup.support_other.hint",
      "required": false,
      "storage": "support",
      "validate": [{ "rule": "max_length", "value": 500, "error": "too_long" }],
      "next": "support_share"
    },
    {
      "id": "support_share",
      "type": "multi_choice",
      "title": "signup.support_share.title",
      "hint": "signup.support_share.hint",
      "required": false,
      "storage": "support",
      "options": [
        { "value": "courses", "label": "signup.support_share.courses" },
        { "value": "employers", "label": "signup.support_share.employers" }
      ],
      "next": "check"
    },
    { "id": "check", "type": "check_answers", "title": "signup.check.title", "next": "done" },
    { "id": "done", "type": "done", "title": "signup.done.title", "hint": "signup.done.hint" }
  ]
}
