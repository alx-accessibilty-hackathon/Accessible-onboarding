# For `docker compose up` (copy to .env; never commit .env).
# Generate each key with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
CODE_HASH_KEY=
# Password of the demo staff accounts (employer@example.org, staff@aaapd.example, ...)
SEED_STAFF_PASSWORD=
# OAuth client secret of the demo partner server "savanna-demo" (random and printed if empty)
SEED_CLIENT_SECRET=
# Optional
# addis = Addis AI speech-to-text (needs ADDIS_AI_API_KEY); mock = sample text for testing
STT_PROVIDERS=mock
EXTRA_ALLOWED_ORIGINS=
# Amharic server voice for read aloud (Addis AI key, sk_...); clips are cached in the database
ADDIS_AI_API_KEY=
ADDIS_AI_VOICE_ID=am-hamen
TTS_DAILY_LIMIT=300
# Real SMS through SMS Ethiopia (console = only logged); see backend/.env.example
SMS_PROVIDER=console
SMSETHIOPIA_API_KEY=
SMS_DAILY_LIMIT=50
